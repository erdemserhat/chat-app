# Security: Disable directory browsing
Options -Indexes

# Security: Protect sensitive files
<Files ~ "^(\.env|\.htaccess|composer\.json|composer\.lock)$">
    Require all denied
</Files>

# Security: Protect source code directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Block access to source directories
    RewriteRule ^(src|vendor|config|logs|tests|scripts)(/.*)?$ - [F,L]
    
    # Redirect all requests to public directory
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [QSA,L]
    
    # Handle root requests
    RewriteRule ^$ public/ [L]
</IfModule>

# Security: Prevent access to backup files
<FilesMatch "\.(bak|backup|swp|tmp)$">
    Require all denied
</FilesMatch>

# Optional: Force HTTPS (uncomment if needed)
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTPS} off
#     RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
